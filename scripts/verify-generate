#!/usr/bin/env sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
cp -R "$root/proto" "$scratch/proto"
(
  cd "$scratch/proto"
  buf build -o ../descriptor.binpb
  buf generate ../descriptor.binpb
)
diff -u "$root/descriptor.binpb" "$scratch/descriptor.binpb"
diff -ru "$root/mcpconfig" "$scratch/mcpconfig"
