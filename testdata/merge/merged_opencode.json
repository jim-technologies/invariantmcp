{
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_xxx"
      },
      "enabled": true
    },
    "legacy": {
      "type": "local",
      "command": [
        "legacy-server"
      ],
      "enabled": false
    },
    "sqlite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "/tmp/test.db"
      ],
      "enabled": true
    }
  },
  "telemetry": {
    "enabled": false
  },
  "theme": "solarized"
}
