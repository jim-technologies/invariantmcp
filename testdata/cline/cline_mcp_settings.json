{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_xxx"
      },
      "transportType": "stdio",
      "disabled": false
    },
    "disabled-server": {
      "command": "some-server",
      "transportType": "stdio",
      "disabled": true
    }
  }
}
